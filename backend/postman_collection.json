{
  "info": {
    "name": "Campus Service Request API",
    "description": "Import into Postman or Thunder Client. Run 'Login as Admin' and 'Login as Student' first — the tokens are saved to collection variables automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "adminToken", "value": "" },
    { "key": "studentToken", "value": "" },
    { "key": "requestId", "value": "" },
    { "key": "staffId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Shourya Garg\",\n  \"email\": \"shourya@campus.edu\",\n  \"password\": \"secret123\",\n  \"department\": \"Computer Science\"\n}" }
          }
        },
        {
          "name": "Login as Student",
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('studentToken', pm.response.json().token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"aarav@campus.edu\",\n  \"password\": \"Student@123\"\n}" }
          }
        },
        {
          "name": "Login as Admin",
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('adminToken', pm.response.json().token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@campus.edu\",\n  \"password\": \"Admin@123\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Student",
      "item": [
        {
          "name": "Create Request",
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('requestId', pm.response.json().data._id);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/api/requests",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"AC not cooling in Lab 301\",\n  \"description\": \"The air conditioner in Lab 301 blows warm air since Monday.\",\n  \"category\": \"Electrical\",\n  \"location\": \"Lab 301\"\n}" }
          }
        },
        { "name": "My Requests", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }], "url": "{{baseUrl}}/api/requests" } },
        { "name": "Get One Request", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }], "url": "{{baseUrl}}/api/requests/{{requestId}}" } },
        {
          "name": "Update Request (Pending only)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/api/requests/{{requestId}}",
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"The AC in Lab 301 blows warm air and makes a loud rattling noise.\"\n}" }
          }
        },
        { "name": "Delete Request (Pending only)", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }], "url": "{{baseUrl}}/api/requests/{{requestId}}" } }
      ]
    },
    {
      "name": "Admin",
      "item": [
        { "name": "All Requests (filters)", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/requests?status=Pending&priority=High&search=lab&sort=newest&page=1&limit=10" } },
        {
          "name": "Staff List",
          "event": [{ "listen": "test", "script": { "exec": ["const s = pm.response.json().data.find(u => u.role === 'staff'); if (s) pm.collectionVariables.set('staffId', s._id);"] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/admin/staff" }
        },
        {
          "name": "Change Status → Under Review",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/requests/{{requestId}}/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"Under Review\",\n  \"priority\": \"High\"\n}" }
          }
        },
        {
          "name": "Invalid Jump → Closed (400)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/requests/{{requestId}}/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"Closed\"\n}" }
          }
        },
        {
          "name": "Assign to Staff",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/requests/{{requestId}}/assign",
            "body": { "mode": "raw", "raw": "{\n  \"assignedTo\": \"{{staffId}}\"\n}" }
          }
        },
        {
          "name": "Change Status + Response",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/requests/{{requestId}}/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"In Progress\",\n  \"adminResponse\": \"Technician will visit today.\"\n}" }
          }
        },
        { "name": "Dashboard", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/admin/dashboard" } },
        { "name": "Delete Any Request", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/requests/{{requestId}}" } }
      ]
    }
  ]
}
