# Copy this file to .env and adjust if needed. Every value has a safe default,
# so the API also runs without a .env file.

PORT=5000

# Leave MONGO_URI empty to use the built-in local MongoDB (data is stored in ./.data).
# To use your own MongoDB / Atlas cluster, paste its connection string here.
MONGO_URI=

# Secret used to sign login tokens — change this to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d
