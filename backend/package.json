{
  "name": "campus-service-api",
  "version": "1.0.0",
  "description": "Campus Service Request & Issue Management System — secure REST API (Express, MongoDB, JWT)",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "express-rate-limit": "7.5.1",
    "express-validator": "7.3.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongodb-memory-server": "10.4.3",
    "mongoose": "8.24.9",
    "morgan": "1.12.1"
  },
  "devDependencies": {
    "supertest": "7.3.2"
  }
}
